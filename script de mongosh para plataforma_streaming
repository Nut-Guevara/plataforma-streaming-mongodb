use("plataforma_streaming");

const generos = ["Ciencia Ficción", "Drama", "Comedia", "Suspenso", "Documental"];
const plataformas = ["Claro Video", "Netflix", "Disney+", "Prime Video"];

const peliculas = [];
for (let i = 1; i <= 115; i++) {
  peliculas.push({
    _id: "PEL-" + String(i).padStart(3, "0"),
    titulo: `Película Estreno ${i}`,
    genero: generos[i % generos.length],
    anio: 2015 + (i % 12),
    duracion_min: 85 + (i % 65),
    plataforma: plataformas[i % plataformas.length],
    disponible: i % 12 !== 0
  });
}
db.peliculas.insertMany(peliculas);

const resenas = [];
for (let j = 1; j <= 115; j++) {
  const numPel = (j % 115) + 1;
  resenas.push({
    _id: "RES-" + String(j).padStart(3, "0"),
    pelicula_id: "PEL-" + String(numPel).padStart(3, "0"),
    usuario: `espectador_${j}`,
    puntuacion: (j % 5) + 1,
    minutos_vistos: 40 + (j % 80),
    recomendada: ((j % 5) + 1) >= 4
  });
}
db.resenas.insertMany(resenas);
